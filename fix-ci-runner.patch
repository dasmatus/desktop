From 7ceb48aa05976b075673047614e48f2e00389dd9 Mon Sep 17 00:00:00 2001
From: Matus Mastena <330471626+dasmatus@users.noreply.github.com>
Date: Mon, 19 Oct 2026 10:30:32 +0000
Subject: [PATCH] fix(ci): keep the release build from killing the runner

prebuild already builds one derivation at a time. The flake job did
not, so on x86_64 WPE WebKit and an LTO link ran together, the runner's
16 GB filled, and the service took it away (exit 143) before anything
could be pushed to the cache.

aarch64 finished the image and then ran out of disk in nix-cache-push.
A batch of 200 paths is a second copy of those paths, and after a
finished image that copy did not fit, so the release was never
uploaded. Batches now also stop at a quarter of the free space, and
the imported prebuild stream is removed once it is in the store.
---
 .github/workflows/ci.yml | 13 +++++++--
 tools/nix-cache-push     | 61 +++++++++++++++++++++++++++++++++-------
 2 files changed, 61 insertions(+), 13 deletions(-)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 8e5c1f8..c385c2f 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -419,6 +419,9 @@ jobs:
           if [ -s prebuilt/paths.txt ]; then
             zstd -dc prebuilt/paths.nar.zst | sudo "$(command -v nix-store)" --import > /dev/null
           fi
+          # The stream is a second copy of paths now in the store. The cache
+          # push writes another copy, and that is what filled the disk.
+          rm -f prebuilt/paths.nar.zst
           echo "Imported $(wc -l < prebuilt/paths.txt) path(s)."
 
       # The check that the split saves anything. Once `prebuild` built all of
@@ -445,11 +448,15 @@ jobs:
       # `prebuild` already pushed.
       - *note-prebuilt
 
+      # One derivation at a time, as in prebuild. This job compiles whatever
+      # that one did not finish, and WPE WebKit beside an LTO link filled the
+      # runner's 16 GB until the service took it away (exit 143) before the
+      # cache push, so a run that died here kept nothing for the next one.
       - name: Build the release
         id: build
         run: |
           set +e
-          timeout --signal=INT 300m nix build --impure -L --keep-going --out-link release .#release \
+          timeout --signal=INT 300m nix build --impure -L --keep-going --max-jobs 1 --out-link release .#release \
             2>&1 | tee build.log
           status=${PIPESTATUS[0]}
           set -e
@@ -489,7 +496,7 @@ jobs:
           {
             sed "s|^|.#checks.$system.|" builds.txt
             sed "s|^|.#checks.$system.|; s|$|.driver|" vm-tests.txt
-          } | xargs nix build --impure -L --keep-going --no-link
+          } | xargs nix build --impure -L --keep-going --max-jobs 1 --no-link
           echo "system=$system" >> "$GITHUB_OUTPUT"
 
       # The VM tests boot the image under QEMU (KVM on x86_64; aarch64 has
@@ -515,7 +522,7 @@ jobs:
           status=124
           if [ "$left" -gt 0 ]; then
             set +e
-            timeout --signal=INT --kill-after=2m "$left" nix build --impure -L --keep-going --no-link "${tests[@]}"
+            timeout --signal=INT --kill-after=2m "$left" nix build --impure -L --keep-going --max-jobs 1 --no-link "${tests[@]}"
             status=$?
             set -e
           fi
diff --git a/tools/nix-cache-push b/tools/nix-cache-push
index a4f9fff..7c6efc5 100755
--- a/tools/nix-cache-push
+++ b/tools/nix-cache-push
@@ -16,8 +16,9 @@
 #   tools/nix-cache-push --repository ... --secret-key-file ... --all \
 #       --exclude-from store-before-build.txt
 #
-# Other options: --jobs N (parallel pushes, 8), --batch N (paths staged at a
-# time, 200), --staging DIR (keep the signed file cache there), --dry-run.
+# Other options: --jobs N (parallel pushes, 8), --batch N (at most this many
+# paths staged at a time, 200; a batch also stops at a quarter of the free
+# disk), --staging DIR (keep the signed file cache there), --dry-run.
 #
 # Needs `nix` and `oras` on PATH, with `oras` already logged in. The secret key
 # stays on this host. nix signs each narinfo as it writes it, and the signature
@@ -166,18 +167,58 @@ export -f push_one
 
 # A runner's disk holds the store once, with no room for a compressed copy of
 # all of it, so the work goes in batches: copy, push, delete the NARs, then the
-# next batch. zstd is fast to write on a runner that is also building, and nix
-# reads it natively. --no-recursive because the list already holds exactly the
+# next batch. Counting to --batch is not enough. After a finished image, 200
+# paths were a second copy of the biggest outputs and the runner's disk filled
+# (aarch64, "No space left on device") before the release could be uploaded.
+# Each batch also stops at a quarter of the free space, measured again after
+# the NARs are deleted. One path bigger than that is a batch by itself: the
+# image has to be copied whole or not at all. zstd is what nix writes and
+# reads natively. --no-recursive because the list already holds exactly the
 # paths to send, in an order that satisfies each one's references.
+# Sizes come back in the same order as the paths. A mismatch means a path
+# went away mid-run, and copying it would fail less clearly later.
+xargs -d '\n' -n 100 nix-store --query --size < "$work/missing" > "$work/sizes"
+if [ "$(wc -l < "$work/sizes")" -ne "$todo" ]; then
+  echo "nix-cache-push: could not read a size for every path" >&2
+  exit 1
+fi
+paste "$work/sizes" "$work/missing" > "$work/sized"
+
+# df's avail is 1 KiB blocks. A quarter of it is the most this batch may
+# stage; the rest stays free for the copy's own scratch.
+batch_cap() {
+  local avail
+  avail=$(df -P --output=avail "$staging" | awk 'NR == 2 { print $1 }')
+  [ -n "$avail" ] || { echo "nix-cache-push: could not read free space on $staging" >&2; exit 1; }
+  echo $((avail * 1024 / 4))
+}
+
 pushed=0
-split -l "$batch" "$work/missing" "$work/batch."
-for chunk in "$work"/batch.*; do
-  nix copy --no-recursive --stdin --to "$to" < "$chunk"
+: > "$work/chunk"
+chunk_bytes=0
+chunk_n=0
+cap=$(batch_cap)
+flush_chunk() {
+  [ "$chunk_n" -gt 0 ] || return 0
+  nix copy --no-recursive --stdin --to "$to" < "$work/chunk"
   # shellcheck disable=SC2016 # expanded by the inner bash, not here
-  xargs -r -n1 basename < "$chunk" | cut -c1-32 \
+  xargs -r -n1 basename < "$work/chunk" | cut -c1-32 \
     | REPO=$repository DRY_RUN=$dry_run xargs -r -P "$jobs" -I{} bash -c 'push_one "$1" "$2"' _ "$staging" {}
   rm -rf "$staging/nar"
-  pushed=$((pushed + $(wc -l < "$chunk")))
+  pushed=$((pushed + chunk_n))
   echo "nix-cache-push: pushed $pushed/$todo"
-done
+  : > "$work/chunk"
+  chunk_bytes=0
+  chunk_n=0
+  cap=$(batch_cap)
+}
+while read -r size path; do
+  if [ "$chunk_n" -gt 0 ] && { [ "$chunk_n" -ge "$batch" ] || [ $((chunk_bytes + size)) -gt "$cap" ]; }; then
+    flush_chunk
+  fi
+  printf '%s\n' "$path" >> "$work/chunk"
+  chunk_bytes=$((chunk_bytes + size))
+  chunk_n=$((chunk_n + 1))
+done < "$work/sized"
+flush_chunk
 echo "nix-cache-push: pushed $todo path(s)"
-- 
2.39.5

